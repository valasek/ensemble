<!-- MOBILE: stacked cards -->
<div class="md:hidden space-y-3">
  <% performances.each do |performance| %>
    <a href="<%= assembly_performance_path(assembly, performance) %>"
       data-turbo-frame="_top"
       class="block card bg-base-200 text-base-content shadow-sm transition-shadow hover:shadow">
      <div class="card-body gap-2 p-4">
        <p class="text-sm text-base-content/70">
          <% if performance.end_date.present? %>
            <%= performance.date.strftime("%d. %m. %Y") %> &ndash; <%= performance.end_date.strftime("%d. %m. %Y") %>
          <% else %>
            <%= performance.date.strftime("%d. %m. %Y") %>
          <% end %>
        </p>
        <p class="card-title text-base leading-snug sm:text-lg"><%= performance.name %></p>
        <% if performance.location.present? %>
          <p class="text-sm text-base-content/80"><%= performance.location %></p>
        <% end %>
        <% if performance.category_names.present? %>
          <p class="text-sm text-base-content/80">
            Kategórie: <%= performance.category_names %>
          </p>
        <% end %>
      </div>
    </a>
  <% end %>
</div>

<!-- DESKTOP: table -->
<div class="hidden md:block overflow-x-auto rounded-box">
  <table class="table table-zebra w-full">
    <colgroup>
      <col class="w-1/4">
      <col class="w-1/3">
      <col class="w-1/4">
      <col class="w-1/4">
    </colgroup>
    <thead>
      <tr>
        <th>Dátum</th>
        <th>Názov</th>
        <th>Kategórie</th>
        <th>Miesto</th>
      </tr>
    </thead>
    <tbody>
      <% performances.each do |performance| %>
        <tr class="hover:bg-base-300 cursor-pointer"
            data-controller="row-link"
            data-action="click->row-link#navigate"
            data-row-link-url-value="<%= assembly_performance_path(assembly, performance) %>">
          <td class="whitespace-nowrap">
            <% if performance.end_date.present? %>
              <%= performance.date.strftime("%d. %m. %Y") %> &ndash; <%= performance.end_date.strftime("%d. %m. %Y") %>
            <% else %>
              <%= performance.date.strftime("%d. %m. %Y") %>
            <% end %>
          </td>
          <td class="whitespace-nowrap text-xl"><%= performance.name %></td>
          <td><%= performance.category_names %></td>
          <td><%= performance.location %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
