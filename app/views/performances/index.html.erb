<div class="min-h-screen bg-base-100">

  <%= render "shared/page_header", title: "Predstavenia, zájazdy a podujatia", back_path: assembly_path(@assembly), back_label: @assembly.name %>

  <section>
    <div class="max-w-4xl mx-auto px-6 py-6 text-center space-y-6">

      <%= render "shared/instant_search" %>

      <%= form_with url: assembly_performances_path(@assembly), method: :get, class: "mx-auto flex w-full max-w-sm flex-col items-stretch gap-3 sm:max-w-2xl sm:flex-row sm:flex-wrap sm:items-end sm:justify-center" do %>
        <div class="form-control w-full sm:max-w-sm">
          <label class="label" for="category_id">
            <span class="label-text mb-1">Filter podľa kategórie</span>
          </label>
          <%= select_tag :category_id,
                         options_from_collection_for_select(@category_options, :id, :name, @selected_category_id),
                         include_blank: "Všetky kategórie",
                         class: "select select-bordered w-full text-base-content",
                         id: "category_id" %>
        </div>
        <%= submit_tag "Filtrovať", class: "btn btn-primary w-full sm:w-auto" %>
        <% if @selected_category_id.present? %>
          <%= link_to "Zrušiť filter", assembly_performances_path(@assembly), class: "btn btn-ghost w-full sm:w-auto" %>
        <% end %>
      <% end %>

      <div class="badge badge-primary badge-outline badge-lg text-primary-content">
        <%= number_with_delimiter(@performances.total_count, delimiter: " ") %> podujatí
      </div>

    </div>
  </section>

  <%= turbo_frame_tag "performances-table" do %>
  <section class="space-y-6 p-4">

    <%= render "performances/performances_list", performances: @performances, assembly: @assembly %>

    <%= paginate @performances, params: { category_id: @selected_category_id.presence } %>
  </section>
  <% end %>


</div>
